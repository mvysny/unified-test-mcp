{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "playwright-mcp",
      "args": [
        "--headless",
        "--isolated",
        "--browser",
        "chromium",
        "--executable-path",
        "/usr/bin/chromium",
        "--viewport-size",
        "1280x720",
        "--no-sandbox"
      ]
    }
  }
}
